# Production placeholders. Copy to docker-compose/.env and replace every
# secret before starting. Do not commit `.env`.
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# docker-compose.prod.yml is a standalone production file. Do not also pass
# -f docker-compose.yml. Do not copy it to docker-compose.override.yml:
# Compose auto-loads that name and a plain `docker compose up` would pick up
# the production bind mounts and port changes.
#
# Stop with the same file: `docker compose -f docker-compose.prod.yml --env-file .env down`
# Do not add -v. `-v` on the dev file (`docker compose down -v`) deletes the
# local named volumes.
#
# Do not use `.env.local`. That file is a Mac development setup (Compose runs
# Postgres only, the server runs on the host) and is not read by Compose
# unless you pass it explicitly.

# Host directory for Postgres data, RustFS objects, and basic_auth.ini.
# Subdirectories postgres/, storage/, and auth/ must exist and be writable
# by the container users. See README "在服务器上部署".
# auth/ stores basic_auth.ini. Users live in PostgreSQL database mlflow_auth
# inside postgres/, not in a SQLite file.
MLFLOW_DATA_DIR=/data/mlflow_data

# PostgreSQL — change POSTGRES_PASSWORD.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
POSTGRES_DB=mlflow
PGPORT=5432

# S3 / RustFS credentials — change both keys. These stay inside the compose
# network; ports 9000 and 9001 are not published.
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_DEFAULT_REGION=us-east-1

RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=mlflow

# MLflow. The standalone docker-compose.prod.yml sets the image to
# hengjian:latest. MLFLOW_VERSION is only interpolated by the local
# docker-compose.yml; this production file does not use it.
MLFLOW_VERSION=latest
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
# Optional. Unset publishes MLFLOW_PORT on all interfaces. Set to 127.0.0.1
# when an HTTPS reverse proxy on this machine is the only public entrypoint.
# MLFLOW_BIND_IP=127.0.0.1
# Auth is PostgreSQL database mlflow_auth, so this may be greater than 1.
# SQLite is no longer the production default. The default stays 1.
MLFLOW_WORKERS=1

MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/${POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# Basic auth. Replace both secrets. The admin password must be at least 12
# characters. It is applied only when the admin user does not exist yet.
# Users and permissions live in PostgreSQL database mlflow_auth on the
# postgres service (same user, password, host, and port as POSTGRES_*).
# Startup creates mlflow_auth if it is missing, including when the Postgres
# data directory was already initialized. Do not point this URI at
# POSTGRES_DB. basic_auth.ini is still written to MLFLOW_AUTH_CONFIG_PATH.
# Do not set MLFLOW_WORKSPACE here. That variable is client-only; the server
# container refuses to start when it is present in the environment.
MLFLOW_FLASK_SERVER_SECRET_KEY=replace-with-a-long-random-flask-secret
MLFLOW_AUTH_ADMIN_USERNAME=admin
MLFLOW_AUTH_ADMIN_PASSWORD=replace-with-12-plus-chars
MLFLOW_AUTH_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/mlflow_auth
MLFLOW_AUTH_CONFIG_PATH=/mlflow/auth/basic_auth.ini
MLFLOW_AUTH_DEFAULT_PERMISSION=READ
MLFLOW_AUTH_GRANT_DEFAULT_WORKSPACE_ACCESS=false
