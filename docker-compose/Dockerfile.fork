# Optional tracking-server image for this fork's UI (Chinese branding).
# The default compose file keeps using ghcr.io/mlflow/mlflow and only adds auth.
#
# From the repository root:
#   docker build -f docker-compose/Dockerfile.fork -t mlflow-fork:local .
#
# The UI build needs Node 24 and several gigabytes of RAM. After the image
# exists, copy docker-compose/docker-compose.override.example.yml to
# docker-compose/docker-compose.override.yml and start the stack as usual.

FROM node:24-bookworm-slim AS ui
WORKDIR /src
COPY mlflow/server/js /src/mlflow/server/js
WORKDIR /src/mlflow/server/js
# Call the Yarn 4 binary vendored in this repo so the image does not depend on corepack.
RUN node yarn/releases/yarn-4.12.0.cjs install --immutable \
    && node yarn/releases/yarn-4.12.0.cjs build

FROM python:3.11-slim-bookworm
WORKDIR /opt/mlflow
COPY pyproject.toml README.md LICENSE.txt ./
COPY mlflow ./mlflow
COPY --from=ui /src/mlflow/server/js/build ./mlflow/server/js/build
RUN pip install --no-cache-dir '.[auth]' 'psycopg[binary]' psycopg2-binary boto3
