# PostgreSQL
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
PGPORT=5432

# S3 Credentials
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin
AWS_DEFAULT_REGION=us-east-1

# RustFS
RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=mlflow

# MLflow
# Official image tag. `--app-name basic-auth` and `--enable-workspaces` are part of
# this fork's server CLI; pin a 3.x release that includes both. `latest` does not
# carry this fork's Chinese UI. See Dockerfile.fork to build that image.
MLFLOW_VERSION=latest
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
# One worker keeps the SQLite auth database simple. Raise this when
# MLFLOW_AUTH_DATABASE_URI points at PostgreSQL.
MLFLOW_WORKERS=1

MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/${POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# Basic auth. Placeholders only — replace before any shared or production use.
# The admin password is read on first start (minimum 12 characters) and then
# stored in the auth database. It is not written into basic_auth.ini.
MLFLOW_FLASK_SERVER_SECRET_KEY=dev-only-change-me-flask-secret
MLFLOW_AUTH_ADMIN_USERNAME=admin
MLFLOW_AUTH_ADMIN_PASSWORD=change-me-admin-12
# Non-production default: SQLite on the `authdata` volume. Production
# (.env.prod.example) uses PostgreSQL database mlflow_auth. Startup creates
# that database when this URI is PostgreSQL, and skips creation for SQLite.
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/mlflow_auth
MLFLOW_AUTH_DATABASE_URI=sqlite:////mlflow/auth/basic_auth.db
MLFLOW_AUTH_CONFIG_PATH=/mlflow/auth/basic_auth.ini
MLFLOW_AUTH_DEFAULT_PERMISSION=READ
# New deployments keep the reserved `default` workspace closed. Set to true only
# when upgrading an existing basic-auth server so current users keep READ there.
MLFLOW_AUTH_GRANT_DEFAULT_WORKSPACE_ACCESS=false
